FROM python:3.13-slim

# Non-root sandbox user (uid 1000).
RUN groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin sandbox

# Create workspace and tmp directories owned by sandbox user.
RUN mkdir -p /sandbox /tmp \
    && chown sandbox:sandbox /sandbox /tmp

USER sandbox
WORKDIR /sandbox

# Entrypoint: execute the mounted script.
ENTRYPOINT ["python", "/sandbox/script.py"]
